
    <div class="background"></div>
    <div class="container">

                        <!-- Menu -->
        <ul class="menu">
            <li><a href="/">Home</a></li>
            <li><a href="/back/list">Listas</a></li>
            <li><a href="/back/guest">Convidados</a></li>
            <li><a href="/back/result">Resultados</a></li>
        </ul>
        <h1>Resultados dos Sorteios</h1>
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Item</th>
                    <th>Número do Sorteio</th>
                </tr>
            </thead>
            <tbody>
                {{#each sorteados}}
                <tr>
                    <td>{{this.name}}</td>
                    <td>{{this.items}}</td>
                    <td>
                        <button class="copy-btn" onclick="manualCopy('{{this.id}}')">
                            <i class="fab fa-whatsapp"></i> Enviar
                        </button>
                    </td>
                </tr>
                
                {{/each}}
            </tbody>
        </table>
    </div>
