<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Countdown Timer com Background</title>
    <style>
        /* Configuração do fundo da página */
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            color: #fff;
            position: relative;
            overflow: hidden;
        }

        /* Imagem de fundo */
        .background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('IMG-20241103-WA0016.jpg'); /* Caminho para a imagem de fundo */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            opacity: 0.4; /* Define a opacidade da imagem */
            z-index: 1;
        }

        /* Sobreposição escura */
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.3); /* Leve sobreposição para escurecer a imagem */
            z-index: 2;
        }

        /* Container do countdown */
        .countdown {
            display: flex;
            gap: 20px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.6); /* Fundo semitransparente para o timer */
            border-radius: 10px;
            z-index: 3;
            position: relative;
        }

        .countdown div {
            text-align: center;
        }

        .countdown span {
            display: block;
            font-size: 2rem;
        }

        .countdown label {
            font-size: 0.9rem;
            color: #ccc;
        }
    </style>
</head>
<body>

<div class="background"></div>
<div class="overlay"></div>

<div class="countdown">
    <div>
        <span id="days">00</span>
        <label>Dias</label>
    </div>
    <div>
        <span id="hours">00</span>
        <label>Horas</label>
    </div>
    <div>
        <span id="minutes">00</span>
        <label>Minutos</label>
    </div>
    <div>
        <span id="seconds">00</span>
        <label>Segundos</label>
    </div>
</div>

<script src="countdown.js"></script>
</body>
</html>
