    <div class="background"></div>
    <div class="container">
        <ul class="menu">
            <li><a href="/">Home</a></li>
            <li><a href="/back/list">Listas</a></li>
            <li><a href="/back/guest">Convidados</a></li>
            <li><a href="/back/result">Resultados</a></li>
        </ul>
        <h1>Convidados</h1>

        <form action="/back/guest" method="POST">
            <div class="form-section">
                <label for="items">Nome:</label>
                <input type="text" name="name">
            </div>
            <button type="submit">Salvar</button>
        </form>

        <h1>Listas</h1>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <form action="/back/sorteio" method="post">
                            <th><input type="submit" value="Sortear"></th>
                        </form>
                        <th></th>
                    </tr>
                    <tr>
                        <th>Nome</th>
                        <th>Acção</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each guests}}
                    <tr>
                        <td>{{this.name}}</td>
                        <form action="/back/guest/{{this.id}}" method="post">
                        <td>
                            <input type="submit" value="Eliminar">
                        </td>
                        </form>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>