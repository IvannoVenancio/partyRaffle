    <div class="background"></div>
    <div class="overlay">
                        <!-- Menu -->
        <ul class="menu">
            <li><a href="/">Home</a></li>
            <li><a href="/back/list">Listas</a></li>
            <li><a href="/back/guest">Convidados</a></li>
            <li><a href="/back/result">Resultados</a></li>
        </ul>
        <h1>Nova Lista</h1>

        <form action="/back/list" method="POST">
            <label for="items">Itens (um por linha):</label>
            <textarea id="items" name="items" rows="5" required></textarea>
            <button type="submit">Criar Lista</button>
        </form>

        <h1>Listas</h1>
        <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Itens</th>
                    <th>Acção</th>
                </tr>
            </thead>
            <tbody>
                {{#each list}}
                <tr>
                    <td>{{this.id}}</td>
                    <td>{{this.items}}</td>
                    <form action="/back/list/{{this.id}}" method="post">
                        <td>
                            <input type="submit" value="Eliminar">
                        </td>
                    </form>
                </tr>
                {{/each}}
            </tbody>
        </table>
      </div>
    </div>