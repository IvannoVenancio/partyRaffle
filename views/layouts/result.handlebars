<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados dos Sorteios</title>
    <style>
        /* Configuração de fundo da página */
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            position: relative;
            overflow: hidden;
            color: #333;
        }

        /* Imagem de fundo */
        .background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('/img/IMG-20241103-WA0016.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            opacity: 0.4;
            z-index: 1;
        }

        /* Conteúdo centralizado */
        .container {
            position: relative;
            background-color: rgba(255, 255, 255, 0.85);
            max-width: 900px;
            width: 90%;
            padding: 30px;
            margin: auto;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
            z-index: 2;
            text-align: center;
        }

        /* Estilos de cabeçalho */
        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        /* Tabela */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background-color: #f8f8f8;
            font-weight: bold;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }



                .copy-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px 12px;
            font-size: 14px;
            background-color: #25D366;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .copy-btn:hover {
            background-color: #1ebc5c;
        }

        .copy-btn i {
            margin-right: 8px;
        }

                      /* Menu */
        .menu {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
            list-style-type: none;
            padding: 0;
        }

        .menu li {
            margin: 0 15px;
        }

        .menu a {
            text-decoration: none;
            color: #333;
            font-weight: bold;
            padding: 8px 16px;
            border-radius: 4px;
            transition: background-color 0.3s;
        }

        .menu a:hover {
            background-color: #ddd;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha384-k6RqeWeci5ZR/Lv4MR0sA0FfDOMPOvA1z/TrFf5A6nKK4lSCARFIIX9JFiAN4M" crossorigin="anonymous">
</head>
<body>
    {{{body}}}
     <script>
function copyLink(id) {
    const linkParaCopiar = `http://nossomatabicho.com/${id}`;
    
    if (navigator.clipboard && navigator.clipboard.writeText) {
        // Se a API Clipboard estiver disponível
        navigator.clipboard.writeText(linkParaCopiar)
            .then(() => {
                const urlWhatsApp = `https://wa.me/?text=${encodeURIComponent(linkParaCopiar)}`;
                window.open(urlWhatsApp, "_blank");
                alert("Link copiado e pronto para enviar no WhatsApp!");
            })
            .catch(err => {
                console.error("Falha ao copiar o link: ", err);
                alert("Não foi possível copiar o link. Tente manualmente.");
            });
    } else {
        // API Clipboard não está disponível
        alert("Seu navegador não suporta a funcionalidade de copiar. Copie manualmente o link: " + linkParaCopiar);
    }
        function manualCopy() {
            const linkParaCopiar = `http://nossomatabicho.com/${id}`;
        const linkInput = document.getElementById('link');
        linkInput.select();
        document.execCommand('copy'); // Compatível com HTTP
        alert('Link copiado para a área de transferência!');
    }
}

    </script>
</body>
</html>
