<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ONOSSOMATABICHO</title>
    <style>
        /* Configuração do fundo da página */
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
            color: #fff;
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        /* Imagem de fundo */
        .background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('/img/IMG-20241103-WA0016.jpg'); /* Caminho para a imagem de fundo */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            opacity: 0.4;
            z-index: 1;
        }

        /* Sobreposição escura */
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.3);
            z-index: 2;
        }

        /* Título principal */
        h1 {
            font-size: 3rem;
            font-weight: bold;
            margin: 0;
            z-index: 3;
            position: relative;
            color: #f9c74f;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.7);
        }

        /* Container do countdown */
        .countdown {
            display: flex;
            gap: 20px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.6);
            border-radius: 10px;
            z-index: 3;
            position: relative;
            margin-top: 20px;
        }

        .countdown div {
            text-align: center;
        }

        .countdown span {
            display: block;
            font-size: 2rem;
        }

        .countdown label {
            font-size: 0.9rem;
            color: #ccc;
        }

        /* Estilo do botão */
        .button {
            margin-top: 30px;
            padding: 12px 25px;
            font-size: 1.2rem;
            color: #fff;
            background-color: #ff7f50;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            z-index: 3;
            position: relative;
            text-decoration: none;
            transition: background-color 0.3s;
        }

        .button:hover {
            background-color: #ff4500;
        }
    </style>
</head>
<body>
{{{body}}}

    <script src="/countdown.js"></script>
</body>
</html>
