<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados dos Sorteios</title>
    <style>
        /* Configuração de fundo da página */
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            position: relative;
            overflow: hidden;
            color: #333;
        }

        /* Imagem de fundo */
        .background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('A_group_of_people_gathered_outdoors,_in_a_friendly.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            opacity: 0.4;
            z-index: 1;
        }

        /* Conteúdo centralizado */
        .container {
            position: relative;
            background-color: rgba(255, 255, 255, 0.85);
            max-width: 900px;
            width: 90%;
            padding: 30px;
            margin: auto;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
            z-index: 2;
            text-align: center;
        }

        /* Estilos de cabeçalho */
        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        /* Tabela */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background-color: #f8f8f8;
            font-weight: bold;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

              /* Botão de cópia para WhatsApp */

    </style>
</head>
<body>
    {{{body}}}
</body>
</html>
